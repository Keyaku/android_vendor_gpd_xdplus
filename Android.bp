// Declarations for imported blobs that a source-built module has to link
// against. Nothing here is our code: these describe where an ALLDOCUBE binary
// lives and what its soname is, which is the same question the rest of this
// repo answers. The reconstruction's own sources stay in the device tree.
//
// Both are real vendor libraries with no soong module anywhere in the tree, so
// a module naming them in shared_libs fails to link even though the runtime
// resolves them without trouble. libdpframework.reconstruct needs both:
// libion_mtk for MediaTek's legacy ion entry points (mt_ion_open, ion_alloc_mm,
// ion_custom_ioctl and the rest) and libm4u for the MTKM4UDrv methods.
//
// ⚠️ These are declarations, not installs. The blobs ship as part of the vendor
// partition image that build_vendor_image.sh bakes from proprietary/vendor;
// soong must not stage a second copy, so both are marked as coming from the
// partition rather than being installed by a build rule.

cc_prebuilt_library_shared {
	name: "libion_mtk",
	proprietary: true,
	compile_multilib: "both",
	arch: {
		arm: {
			srcs: ["proprietary/vendor/lib/libion_mtk.so"],
		},
		arm64: {
			srcs: ["proprietary/vendor/lib64/libion_mtk.so"],
		},
	},
	// The blob is stripped as shipped and its own DT_NEEDED set is satisfied
	// at load, not by soong.
	strip: {
		none: true,
	},
	check_elf_files: false,
	installable: false,
}

cc_prebuilt_library_shared {
	name: "libm4u",
	proprietary: true,
	compile_multilib: "both",
	arch: {
		arm: {
			srcs: ["proprietary/vendor/lib/libm4u.so"],
		},
		arm64: {
			srcs: ["proprietary/vendor/lib64/libm4u.so"],
		},
	},
	strip: {
		none: true,
	},
	check_elf_files: false,
	installable: false,
}
