
; --- GPD XD+ addendum -------------------------------------------------------
; The OMX HAL is served from /system on this port (the vendor blob set has no
; system-side OMX service), so its domain is declared in the system_ext policy.
; These rules cannot live there: every target type below is declared in this
; file, which is loaded at runtime, so naming them at build time fails with
; `unknown type`. secilc compiles plat, mapping, system_ext and this file
; together at boot, so the cross-reference resolves here.
;
; Not cosmetic: without them `screenrecord` fails outright under enforcement
; (exit 235, zero-byte file) while succeeding under permissive.
(allow hal_omx_xdplus dri_device (chr_file (read write open ioctl getattr map lock)))
(allow hal_omx_xdplus render_device (chr_file (read write open ioctl getattr map lock)))
(allow hal_omx_xdplus debugfs_ion (dir (search)))
(allow hal_omx_xdplus mtk_em_video_log_omx_prop (file (read open getattr map)))
; The GED bridge, same reason: proc_ged is declared here. The OEM grants this to
; its own mediacodec domain, which this port replaced with a system-side one.
(allow hal_omx_xdplus proc_ged (file (read write open getattr ioctl map)))
; /dev/Vcodec, the MTK video codec device itself -- the encoder returns -38
; without it.
(allow hal_omx_xdplus Vcodec_device (chr_file (read write open ioctl getattr map lock)))
; CMDQ (the display/codec command queue) and the /proc entries the components
; read for their own tuning.
(allow hal_omx_xdplus mtk_cmdq_device (chr_file (read write open ioctl getattr map lock)))
; /proc/m4u is the MTK IOMMU control node and carries no label of its own, so
; this is the generic proc type. ioctl is the point of it (ioctlcmd 0x671a);
; the GED 'g' page is already whitelisted for xperm in the system_ext policy.
; Deliberately not relabelled via genfscon: the vendor blobs reach /proc/m4u
; through this same generic type, and moving it would break them instead.
(allow hal_omx_xdplus proc (file (read open getattr map ioctl)))
; The MTK engineering-mode video switches. They are read on every component
; init; each is its own property type, so they are listed rather than matched.
(allow hal_omx_xdplus mtk_em_video_venc_h264_prop (file (read open getattr map)))
(allow hal_omx_xdplus mtk_em_video_log_acodec_prop (file (read open getattr map)))
(allow hal_omx_xdplus mtk_em_video_log_sf_postbuffer_prop (file (read open getattr map)))
(allow hal_omx_xdplus mtk_em_video_log_vdec_prop (file (read open getattr map)))
(allow hal_omx_xdplus mtk_em_video_log_svp_prop (file (read open getattr map)))
(allow hal_omx_xdplus mtk_em_video_log_mjc_prop (file (read open getattr map)))

; Decode path. The OMX service is handed graphics buffers by the vendor
; allocator, and any app that plays video reaches the render node and the ION
; debugfs directory directly through the blob stack. hal_graphics_allocator_default,
; render_device and debugfs_ion are all declared in this file, which is why
; these rules cannot live in the system_ext policy either.
(allow hal_omx_xdplus hal_graphics_allocator_default (fd (use)))
(allow gallery_app render_device (chr_file (read write open ioctl getattr map)))
(allow gallery_app debugfs_ion (dir (search)))
(allow mediaserver debugfs_ion (dir (search)))

; Sensors HAL. The OEM vendor CIL declares mtk_hal_sensors but does not grant
; access to /dev/input/event*, and the platform hal_sensors_default rule does not
; cover this vendor domain. Under enforcing the denial crashes SensorService.
(allow mtk_hal_sensors input_device (dir (open getattr read search ioctl lock watch watch_reads)))
(allow mtk_hal_sensors input_device (chr_file (ioctl read getattr lock map open watch watch_reads)))

; initcleanrom. The OEM vendor CIL declares the domain and its exec type, but the
; service runs a shell script that needs shell/toolbox execution plus access to
; nvdata, sysfs and /cache/recovery to set up headphone-jack polarity, gamepad
; mode, CPU freq permissions and recovery command path.
(allow initcleanrom shell_exec (file (read getattr execute execute_no_trans entrypoint open)))
(allow initcleanrom toolbox_exec (file (read getattr execute execute_no_trans open)))
(allow initcleanrom nvdata_file (dir (open getattr read search add_name write setattr)))
(allow initcleanrom nvdata_file (file (create open read write getattr setattr)))
(allow initcleanrom initcleanrom (capability (fowner fsetid chown)))
(allow initcleanrom sysfs (dir (search)))
(allow initcleanrom sysfs (file (open read write getattr setattr)))
; initcleanrom adjusts CPU scaling limits for the big cluster.
(allow initcleanrom sysfs_devices_system_cpu (file (open read write getattr setattr)))
(allow initcleanrom graphics_device (chr_file (getattr setattr)))
(allow initcleanrom cache_file (dir (search getattr add_name write remove_name)))
(allow initcleanrom cache_file (file (create open read write getattr setattr unlink)))
(allow initcleanrom cache_recovery_file (dir (search getattr add_name write remove_name setattr)))
(allow initcleanrom cache_recovery_file (file (create open read write getattr setattr unlink)))

; GED event notify debugfs node is declared in the OEM vendor CIL; the composer
; writes it on this device.
(allow hal_graphics_composer_default debugfs_ged (file (open read write getattr)))

; Composer and surfaceflinger read /sys/devices/virtual/BOOT/BOOT/boot/boot_mode.
; surfaceflinger is a platform domain and is handled in device-side policy;
; composer is a vendor domain and can only be referenced here.
(allow hal_graphics_composer_default sysfs (dir (open getattr read search ioctl lock watch watch_reads)))
(allow hal_graphics_composer_default sysfs (file (ioctl read getattr lock map open watch watch_reads)))

; SurfaceFlinger reads the composer's /proc/<pid>/cmdline under enforcement.
; The target domain is declared in this vendor policy, so the allow belongs here.
(allow surfaceflinger hal_graphics_composer_default (file (read open getattr)))

; The composer sets ro.sf.lcd_density from a vendor property context and reads
; the xdplus device-specific properties declared in system_ext policy.
(allow hal_graphics_composer_default exported3_default_prop (property_service (set)))
(allow hal_graphics_composer_default xdplus_prop (file (read open getattr map)))

; The vendor audio HAL passes a FIFO to audioserver; the HAL domain needs write.
(allow mtk_hal_audio audioserver (fifo_file (write)))

; The Wi-Fi driver firmware loader runs in the kernel domain and needs dac_override
; to access its firmware nodes under /data/misc.
(allow kernel kernel (capability (dac_override)))

; The autokd calibration daemon has its own exec label; it reads /vendor/nvdata
; for the fstab and calibration data, updates the SDIO calibration file, and
; reads its per-device calibration record from /data.
(allow autokd nvdata_file (dir (open getattr read search)))
(allow autokd nvdata_file (file (open read write getattr)))
(allow autokd system_data_root_file (dir (search open read getattr)))
(allow autokd system_data_file (file (read open getattr)))
; autokd signals completion through a system property after reading calibration.
(allow autokd self (tcp_socket (create)))
(allow autokd property_socket (sock_file (write)))
(allow autokd init (unix_stream_socket (connectto)))
(allow autokd system_prop (property_service (set)))
