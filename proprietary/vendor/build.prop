# Deliberately empty. Build.isBuildConsistent() compares this against
# ro.system.build.fingerprint and raises "Internal problem with your device" on any
# mismatch, but it skips the comparison entirely when this is empty. This partition
# is a frozen third-party blob set with no build identity of its own, so claiming
# the system's fingerprint would be a fiction and claiming ALLDOCUBE's would trip
# the check. Empty is the honest value that also lets the system side carry a real
# per-build incremental. ro.odm and ro.bootimage are already empty on this device
# and every consumer skips empty fingerprints by design.
ro.vendor.build.fingerprint=
# What this partition actually is. Free-form and uncompared, unlike the above.
ro.vendor.xdplus.blobs=ALLDOCUBE U1005E 8.1 (PowerVR DDK 1.9@4893595), camera-stripped, hwc acqfd-patched
# Bumped whenever this partition gains something the system side depends on.
# device/gpd/xdplus/releasetools.py asserts on it so an OTA cannot half-apply.
ro.vendor.xdplus.rev=1
