# MTK platform .rc configure
on post-fs-data
    # calibration
    mkdir /data/misc/sensor 0774 system system

    # Sensor (I really have to change the permissions back to 660 and fix it in sepolicy...)
    chmod 0666 /dev/hwmsensor
    chmod 0666 /dev/msensor
    chmod 0666 /dev/gsensor
    chmod 0666 /dev/als_ps
    chmod 0666 /dev/gyroscope
    chmod 0666 /dev/aal_als

    chmod 0666 /sys/devices/platform/msensor/driver/cpsopmode
    chmod 0666 /sys/devices/platform/msensor/driver/cpsreptxy
    chmod 0666 /sys/devices/platform/msensor/driver/cpsreptz
    chmod 0666 /sys/devices/platform/gsensor/driver/cpsopmode
    chmod 0666 /sys/devices/platform/gsensor/driver/cpsrange
    chmod 0666 /sys/devices/platform/gsensor/driver/cpsbandwidth

    chown system system /dev/hwmsensor
    chown system system /dev/msensor
    chown system system /dev/gsensor
    chown radio system /dev/als_ps
    chown system system /dev/gyroscope
    chown system system /dev/aal_als

    chmod 0666 /sys/class/misc/m_acc_misc/accenablenodata
    chmod 0666 /sys/class/misc/m_acc_misc/accactive
    chmod 0666 /sys/class/misc/m_acc_misc/accdelay
    chmod 0666 /sys/class/misc/m_acc_misc/accbatch
    chmod 0666 /sys/class/misc/m_acc_misc/accflush
    chown system system /sys/class/misc/m_acc_misc/accenablenodata
    chown system system /sys/class/misc/m_acc_misc/accactive
    chown system system /sys/class/misc/m_acc_misc/accdelay
    chown system system /sys/class/misc/m_acc_misc/accbatch
    chown system system /sys/class/misc/m_acc_misc/accflush

    # It should only need event4, but I don't know if this can shift...
    chmod 0666 /dev/input/event0
    chmod 0666 /dev/input/event1
    chmod 0666 /dev/input/event2
    chmod 0666 /dev/input/event3
    chmod 0666 /dev/input/event4
    chmod 0666 /dev/input/event5
    chmod 0666 /dev/input/event6
    chmod 0666 /dev/input/event7
